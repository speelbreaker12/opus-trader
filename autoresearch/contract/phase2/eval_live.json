{
  "description": "Contract autoresearch phase 2 live proposal generation — runs detection + proposal on current CONTRACT.md section snapshots",
  "tests": [
    {
      "id": "live-liquidity-gate",
      "fixture": "fixtures/snapshot/s1_3_liquidity_gate_latest.md",
      "output_file": "s1_3_liquidity_gate_latest/proposals.json",
      "assertions": [
        {
          "id": "lg-p2-schema",
          "check": "proposal payload matches schema",
          "rule": {
            "type": "json_schema_valid",
            "schema_path": "autoresearch/contract/phase2/proposals.schema.json"
          }
        },
        {
          "id": "lg-p2-unique-ids",
          "check": "proposal ids stay unique",
          "rule": {
            "type": "json_unique_field",
            "path": "$.proposals[*].proposal_id"
          }
        }
      ]
    },
    {
