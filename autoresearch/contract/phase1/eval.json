            "path": "$.findings[*].finding_id"
          }
        },
        {
          "id": "tmc-count",
          "check": "detector emits a non-trivial finding set for TradingMode",
          "rule": {
            "type": "json_array_count_bounds",
            "path": "$.findings",
            "min": 5,
            "max": 7
          }
        },
        {
          "id": "tmc-category",
          "check": "detector still finds a gate interaction gap in TradingMode",
          "rule": {
            "type": "json_field_match",
            "path": "$.findings[*].category",
            "value": "gate_interaction_gap",
            "match_mode": "any"
          }
        },
        {
          "id": "tmc-section",
          "check": "detector still anchors a finding to dispatch authorization semantics",
          "rule": {
            "type": "json_field_match",
            "path": "$.findings[*].section",
            "pattern": "Dispatch Authorization",
            "match_mode": "any"
          }
        }
      ]
    },
