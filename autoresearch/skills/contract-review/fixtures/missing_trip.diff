+use crate::execution::{GateResult, RejectReasonCode};
+use crate::types::TickContext;
+
+/// Spread Gate: blocks OPEN orders when the bid-ask spread exceeds
+/// the configured threshold for the instrument.
+///
+/// Contract: §2.3.7 — "OPEN orders MUST be rejected when the quoted
+/// spread exceeds the instrument's max_spread_bps threshold."
+pub struct SpreadGate {
+    max_spread_bps: f64,
+}
+
+impl SpreadGate {
+    pub fn new(max_spread_bps: f64) -> Self {
+        Self { max_spread_bps }
+    }
+
+    pub fn check(&self, ctx: &TickContext) -> GateResult {
+        let spread_bps = ctx.current_spread_bps();
+
+        if spread_bps > self.max_spread_bps {
+            GateResult::Reject(RejectReasonCode::SpreadTooWide)
+        } else {
+            GateResult::Pass
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_spread_gate_basic() {
+        let gate = SpreadGate::new(10.0);
+        // Only tests construction, no TRIP/NON-TRIP coverage
+    }
+}
