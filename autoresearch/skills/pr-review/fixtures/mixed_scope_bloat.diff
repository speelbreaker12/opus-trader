diff --git a/python/tools/dashboard.py b/python/tools/dashboard.py
new file mode 100644
index 0000000..iii0000
--- /dev/null
+++ b/python/tools/dashboard.py
@@ -0,0 +1,28 @@
+"""Real-time trading dashboard with curses UI."""
+
+import curses
+import time
+
+
+def render_dashboard(stdscr):
+    """Render a live dashboard showing PnL and positions."""
+    curses.curs_set(0)
+    stdscr.nodelay(True)
+
+    while True:
+        stdscr.clear()
+        stdscr.addstr(0, 0, "=== Trading Dashboard ===")
+        stdscr.addstr(2, 0, f"Time: {time.strftime('%H:%M:%S')}")
+        stdscr.addstr(3, 0, "PnL: $0.00")
+        stdscr.addstr(4, 0, "Positions: 0")
+        stdscr.refresh()
+        time.sleep(1)
+
+        key = stdscr.getch()
+        if key == ord('q'):
+            break
+
+
+def main():
+    curses.wrapper(render_dashboard)
+
+
+if __name__ == "__main__":
+    main()
