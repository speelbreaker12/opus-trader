+use crate::execution::{GateResult, RejectReasonCode};
+use crate::types::TickContext;
+
+/// VolatilityGate: blocks OPEN orders when implied volatility exceeds
+/// the per-instrument safety threshold.
+///
+/// Contract: §2.3.8 — "OPEN orders MUST be rejected when the instrument's
+/// current implied volatility exceeds iv_max_threshold."
+///
+/// Safety-critical: incorrect dispatch during high-vol can cause
+/// immediate mark-to-market loss exceeding risk budget.
+pub struct VolatilityGate {
+    iv_max_threshold: f64,
+}
+
+impl VolatilityGate {
+    pub fn new(iv_max_threshold: f64) -> Self {
+        Self { iv_max_threshold }
+    }
+
+    /// Check whether the current IV is within the safe threshold.
+    /// Fail-closed: if IV data is missing (None), reject the order.
+    pub fn check(&self, ctx: &TickContext) -> GateResult {
+        let current_iv = match ctx.current_iv() {
+            Some(iv) => iv,
+            None => {
+                tracing::warn!("VolatilityGate: IV data missing, rejecting (fail-closed)");
+                return GateResult::Reject(RejectReasonCode::VolatilityDataMissing);
+            }
+        };
+
+        if current_iv > self.iv_max_threshold {
+            tracing::info!(iv = current_iv, threshold = self.iv_max_threshold,
+                "VolatilityGate: IV exceeds threshold, rejecting");
+            GateResult::Reject(RejectReasonCode::VolatilityTooHigh)
+        } else {
+            GateResult::Pass
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_volatility_gate_rejects_high_iv() {
+        let gate = VolatilityGate::new(0.80);
+        // Only tests construction — no TRIP/NON-TRIP acceptance test
+        // No dispatch_count or reject_reason assertion
+    }
+}
