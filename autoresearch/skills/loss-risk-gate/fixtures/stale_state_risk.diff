@@ -22,18 +22,14 @@ impl PreflightGate {
     /// Run all preflight checks before allowing order dispatch.
     /// This includes position reconciliation, balance verification,
     /// and market data freshness checks.
-    pub fn check(&self, ctx: &TickContext) -> GateResult {
-        // Verify market data is fresh enough to trade on
-        let book_age_ms = ctx.l2_book_age_ms();
-        if book_age_ms > self.max_book_age_ms {
-            tracing::warn!(
-                book_age_ms,
