@@ -0,0 +1,25 @@
+"""Track execution state across parallel CI jobs."""
+
+import json
+from pathlib import Path
+
+STATE_FILE = Path(".state/execution.json")
+
+def read_state() -> dict:
+    if STATE_FILE.exists():
+        return json.loads(STATE_FILE.read_text())
+    return {}
+
+def update_state(key: str, value: str) -> None:
+    state = read_state()
+    state[key] = value
+    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
+    STATE_FILE.write_text(json.dumps(state, indent=2))
+
+def mark_complete(job_name: str) -> None:
+    update_state(job_name, "complete")
+
+def all_complete(job_names: list[str]) -> bool:
+    state = read_state()
+    return all(state.get(j) == "complete" for j in job_names)
