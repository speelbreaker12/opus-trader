+"""Cache audit results to avoid re-running expensive checks."""
+
 import json
+import hashlib
 from pathlib import Path

+CACHE_DIR = Path(".cache/audit")
+
+def get_cache_key(slice_id: str, config_path: Path) -> str:
+    config_hash = hashlib.sha256(config_path.read_bytes()).hexdigest()[:8]
+    return f"{slice_id}_{config_hash}"
+
+def load_cached_result(slice_id: str, config_path: Path) -> dict | None:
+    key = get_cache_key(slice_id, config_path)
+    cache_file = CACHE_DIR / f"{key}.json"
+    if cache_file.exists():
+        return json.loads(cache_file.read_text())
+    return None
+
+def save_cached_result(slice_id: str, config_path: Path, result: dict) -> None:
+    CACHE_DIR.mkdir(parents=True, exist_ok=True)
+    key = get_cache_key(slice_id, config_path)
+    cache_file = CACHE_DIR / f"{key}.json"
+    cache_file.write_text(json.dumps(result))
+
 def run_audit(slice_id: str, config_path: Path) -> dict:
-    with open(config_path) as f:
-        config = json.load(f)
-    # ... expensive audit logic ...
-    return {"slice": slice_id, "status": "pass"}
+    cached = load_cached_result(slice_id, config_path)
+    if cached:
+        return cached
+    with open(config_path) as f:
+        config = json.load(f)
+    result = {"slice": slice_id, "status": "pass"}
+    save_cached_result(slice_id, config_path, result)
+    return result
