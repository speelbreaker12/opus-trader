diff --git a/plans/verify.sh b/plans/verify.sh
index aaa1111..bbb2222 100644
--- a/plans/verify.sh
+++ b/plans/verify.sh
@@ -1,8 +1,10 @@
 #!/usr/bin/env bash
-# verify.sh — Run all verification gates.
+# verify.sh — Run all verification gates (or skip eligible ones).
 #
-# Exit codes:
+# Exit code semantics:
 #   0 — All gates ran and passed.
+#      NOTE: With VERIFY_SKIP_ELIGIBLE=1, exit 0 means "all gates that
+#      were required to run passed; eligible gates may have been skipped."
 #   1 — At least one gate failed.
 #   2 — Usage error.

@@ -10,6 +12,8 @@
 # Environment variables:
 #   VERIFY_MODE: quick | full (default: quick)
 #   VERIFY_SKIP_GATES: comma-separated list of gate names to skip
+#   VERIFY_SKIP_ELIGIBLE: 1 to allow skipping gates marked as skip-eligible
+#     when their inputs haven't changed since last successful run (default: 0)

 set -euo pipefail

@@ -25,6 +29,7 @@ log_error() {

 FAILED_GATES=()
 MODE="${VERIFY_MODE:-quick}"
+SKIP_ELIGIBLE="${VERIFY_SKIP_ELIGIBLE:-0}"

 # Gate registry — each gate declares whether it is skip-eligible
 declare -A GATE_SKIP_ELIGIBLE=(
@@ -45,12 +50,33 @@ declare -A GATE_SKIP_ELIGIBLE=(
   [contract_coverage]=false
 )

+should_skip_eligible() {
+  local gate_name="$1"
+  [[ "$SKIP_ELIGIBLE" == "1" ]] || return 1
+  [[ "${GATE_SKIP_ELIGIBLE[$gate_name]:-false}" == "true" ]] || return 1
+  # Check if inputs changed since last pass
+  local last_hash_file=".verify_cache/${gate_name}.last_pass_hash"
+  [[ -f "$last_hash_file" ]] || return 1
+  local current_hash
+  current_hash=$(gate_input_hash "$gate_name")
+  local stored_hash
+  stored_hash=$(cat "$last_hash_file")
+  [[ "$current_hash" == "$stored_hash" ]]
+}
+
 run_gate() {
   local gate_name="$1"
   shift

+  # Skip-eligible check
+  if should_skip_eligible "$gate_name"; then
+    log_info "SKIP (eligible, inputs unchanged): $gate_name"
+    SKIPPED_GATES+=("$gate_name")
+    return 0
+  fi
+
   log_info "RUN: $gate_name"
   "$@"
   local rc=$?

   if [[ $rc -eq 0 ]]; then
     log_info "PASS: $gate_name"
+    # Record hash for skip-eligible check
+    mkdir -p .verify_cache
+    gate_input_hash "$gate_name" > ".verify_cache/${gate_name}.last_pass_hash"
   else
     log_error "FAIL: $gate_name (exit $rc)"
     FAILED_GATES+=("$gate_name")
@@ -75,8 +101,16 @@ run_all_gates() {

 run_all_gates

+SKIPPED_GATES=()
+
 if [[ ${#FAILED_GATES[@]} -gt 0 ]]; then
   log_error "FAILED gates: ${FAILED_GATES[*]}"
   exit 1
 fi
-log_info "VERIFY OK (mode=$MODE): all gates passed"
+
+if [[ ${#SKIPPED_GATES[@]} -gt 0 ]]; then
+  log_info "VERIFY OK (mode=$MODE): ${#SKIPPED_GATES[@]} gate(s) skipped, remainder passed"
+else
+  log_info "VERIFY OK (mode=$MODE): all gates passed"
+fi
+exit 0
