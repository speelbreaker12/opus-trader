 # VERIFY_MODE: quick | full (default: quick)
 # VERIFY_SKIP_GATES: comma-separated list of gate names to skip (e.g. "clippy,contract_coverage")
 #   existing skip mechanism: reads from change_detection output to skip unchanged gates
+# VERIFY_CHECKPOINT_ENABLED: 1 to enable checkpoint-based skip (default: 0)
+# VERIFY_CHECKPOINT_DIR: directory for checkpoint state (default: .verify_checkpoints)

 set -euo pipefail

@@ -45,6 +47,52 @@ should_skip_via_change_detection() {
   return 1
 }

+# --- Checkpoint-based skip system (parallel to change_detection) ---
+# Maintains a fingerprint of gate inputs. If fingerprint matches the
+# last successful run, the gate is skipped entirely.
+
+CHECKPOINT_DIR="${VERIFY_CHECKPOINT_DIR:-.verify_checkpoints}"
+
+checkpoint_fingerprint() {
+  local gate_name="$1"
+  # Hash the relevant source files for this gate
+  local files
+  files=$(gate_input_files "$gate_name")
+  echo "$files" | sort | xargs sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1
+}
+
+should_skip_via_checkpoint() {
+  local gate_name="$1"
+  [[ "${VERIFY_CHECKPOINT_ENABLED:-0}" == "1" ]] || return 1
+
+  local fp_file="$CHECKPOINT_DIR/${gate_name}.fingerprint"
+  [[ -f "$fp_file" ]] || return 1
+
+  local current_fp
+  current_fp=$(checkpoint_fingerprint "$gate_name")
+  local stored_fp
+  stored_fp=$(cat "$fp_file")
+
+  if [[ "$current_fp" == "$stored_fp" ]]; then
+    log_info "CHECKPOINT SKIP: $gate_name (fingerprint match)"
+    return 0
+  fi
+  return 1
+}
+
+record_checkpoint() {
+  local gate_name="$1"
+  [[ "${VERIFY_CHECKPOINT_ENABLED:-0}" == "1" ]] || return 0
+  mkdir -p "$CHECKPOINT_DIR"
+  checkpoint_fingerprint "$gate_name" > "$CHECKPOINT_DIR/${gate_name}.fingerprint"
+}
+
 run_gate() {
   local gate_name="$1"
   shift
@@ -53,6 +101,11 @@ run_gate() {
     log_info "SKIP (change_detection): $gate_name"
     return 0
   fi
+  # Check checkpoint-based skip (second skip system)
+  if should_skip_via_checkpoint "$gate_name"; then
+    log_info "SKIP (checkpoint): $gate_name"
+    return 0
+  fi

   log_info "RUN: $gate_name"
   "$@"
@@ -60,6 +113,7 @@ run_gate() {
   if [[ $rc -eq 0 ]]; then
     log_info "PASS: $gate_name"
+    record_checkpoint "$gate_name"
   else
     log_error "FAIL: $gate_name (exit $rc)"
     FAILED_GATES+=("$gate_name")
