index aaa1111..bbb2222 100644
--- a/crates/soldier_core/src/execution/quantizer.rs
+++ b/crates/soldier_core/src/execution/quantizer.rs
@@ -42,6 +42,15 @@ impl Quantizer {
         }
     }
+
+    /// Round quantity to the nearest tick size, returning error if result is zero.
+    pub fn round_to_tick(&self, qty: f64, tick_size: f64) -> Result<f64, QuantizeError> {
+        let rounded = (qty / tick_size).round() * tick_size;
+        if rounded <= 0.0 {
+            return Err(QuantizeError::ZeroQuantity);
+        }
+        Ok(rounded)
+    }
 }
