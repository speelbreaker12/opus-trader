+/// Volatility Gate: blocks OPEN when realized vol exceeds threshold.
+/// Contract: §2.3.9
+pub struct VolatilityGate {
+    max_vol_pct: f64,
+}
+
+impl VolatilityGate {
+    pub fn new(max_vol_pct: f64) -> Self {
+        Self { max_vol_pct }
+    }
+
+    pub fn check(&self, realized_vol: f64) -> GateResult {
+        if realized_vol > self.max_vol_pct {
+            GateResult::Reject(RejectReasonCode::VolatilityTooHigh)
+        } else {
+            GateResult::Pass
+        }
+    }
+}
