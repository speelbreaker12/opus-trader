+use crate::execution::{GateResult, RejectReasonCode};
+use crate::types::TickContext;
+
+/// Correlation Gate: blocks OPEN orders when portfolio correlation
+/// to a single asset exceeds concentration limit.
+///
+/// Contract: SS2.3.10 — "OPEN orders MUST be rejected when portfolio
+/// concentration exceeds max_correlation_pct."
+///
+/// Enforcement point: DispatcherChokepoint
+pub struct CorrelationGate {
+    max_correlation_pct: f64,
+}
+
+impl CorrelationGate {
+    pub fn new(max_correlation_pct: f64) -> Self {
+        Self { max_correlation_pct }
+    }
+
+    pub fn check(&self, ctx: &TickContext) -> GateResult {
+        let correlation = ctx.portfolio_max_correlation_pct();
+
+        if correlation > self.max_correlation_pct {
+            GateResult::Reject(RejectReasonCode::CorrelationTooHigh)
+        } else {
+            GateResult::Pass
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_correlation_gate_exists() {
+        let _gate = CorrelationGate::new(0.8);
+    }
+}
