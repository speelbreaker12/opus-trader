+use crate::execution::{GateResult, RejectReasonCode};
+use crate::types::{IntentClass, TickContext};
+
+/// Volatility Gate: blocks OPEN orders when realized volatility exceeds
+/// the configured ceiling for the instrument.
+///
+/// Contract: SS2.3.8 — "OPEN orders MUST be rejected when 5-min realized
+/// vol exceeds vol_ceiling_bps."
+///
+/// Enforcement point: DispatcherChokepoint
+pub struct VolatilityGate {
+    vol_ceiling_bps: f64,
+}
+
+impl VolatilityGate {
+    pub fn new(vol_ceiling_bps: f64) -> Self {
+        Self { vol_ceiling_bps }
+    }
+
+    pub fn check(&self, intent_class: &IntentClass, ctx: &TickContext) -> GateResult {
+        // Fail-closed: if vol data is missing or NaN, reject OPEN
+        let vol = match ctx.realized_vol_5m_bps() {
+            Some(v) if v.is_finite() => v,
+            _ => {
+                tracing::warn!("volatility data missing or NaN — fail-closed reject");
+                return GateResult::Reject(RejectReasonCode::VolatilityDataMissing);
+            }
+        };
+
+        match intent_class {
+            IntentClass::Open if vol > self.vol_ceiling_bps => {
+                tracing::info!(vol_bps = vol, ceiling = self.vol_ceiling_bps, "vol gate TRIP");
+                GateResult::Reject(RejectReasonCode::VolatilityTooHigh)
+            }
+            _ => GateResult::Pass,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_vol_gate_rejects_high_vol_open() {
+        let gate = VolatilityGate::new(50.0);
+        let ctx = TickContext::with_vol(100.0);
+        let result = gate.check(&IntentClass::Open, &ctx);
+        assert!(matches!(result, GateResult::Reject(RejectReasonCode::VolatilityTooHigh)));
+    }
+}
