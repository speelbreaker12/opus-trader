@@ -0,0 +1,62 @@
+//! AT-060: VolatilityGate acceptance tests with TRIP/NON-TRIP causal proof
+
+use soldier_core::execution::{ExecutionEngine, ExecutionInput};
+use soldier_core::test_helpers::TestScenario;
+
+/// TRIP test: vol exceeds ceiling -> OPEN order rejected
+/// Proves: dispatch_count == 0, reject_reason == VolatilityTooHigh
+#[test]
+fn test_at060_vol_gate_trip_open_rejected_when_vol_exceeds_ceiling() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_realized_vol_bps(100.0)    // above 50 bps ceiling
+        .with_vol_ceiling_bps(50.0);
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 0, "OPEN must not dispatch when vol exceeds ceiling");
+    assert_eq!(
+        result.reject_reason,
+        RejectReasonCode::VolatilityTooHigh,
+        "reject reason must be VolatilityTooHigh"
+    );
+}
+
+/// NON-TRIP test: vol below ceiling -> OPEN order passes through
+/// Proves: dispatch_count == 1 (gate does not block)
+#[test]
+fn test_at060_vol_gate_non_trip_open_passes_when_vol_below_ceiling() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_realized_vol_bps(30.0)     // below 50 bps ceiling
+        .with_vol_ceiling_bps(50.0);
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 1, "OPEN must dispatch when vol is below ceiling");
+}
+
+/// TRIP test: missing vol data -> fail-closed reject
+/// Proves: dispatch_count == 0, reject_reason == VolatilityDataMissing
+#[test]
+fn test_at060_vol_gate_trip_missing_vol_data_fail_closed() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .without_vol_data();              // no vol data at all
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 0, "OPEN must not dispatch when vol data missing");
+    assert_eq!(
+        result.reject_reason,
+        RejectReasonCode::VolatilityDataMissing,
+        "reject reason must be VolatilityDataMissing"
+    );
+}
+
+/// NON-TRIP test: CLOSE intent passes even when vol exceeds ceiling
+/// Proves: dispatch_count == 1 (gate only blocks OPEN)
+#[test]
+fn test_at060_vol_gate_non_trip_close_passes_when_vol_exceeds_ceiling() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_realized_vol_bps(100.0)
+        .with_vol_ceiling_bps(50.0);
+
+    let result = scenario.dispatch_close_intent();
+
+    assert_eq!(result.dispatch_count, 1, "CLOSE must dispatch even when vol exceeds ceiling");
+}
