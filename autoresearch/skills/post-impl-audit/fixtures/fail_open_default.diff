+use crate::execution::{GateResult, RejectReasonCode};
+use crate::policy::TradingMode;
+use crate::types::TickContext;
+
+/// Drawdown Gate: blocks OPEN orders when daily drawdown exceeds
+/// the configured max drawdown percentage.
+///
+/// Contract: SS2.3.11 — "OPEN orders MUST be rejected when daily
+/// drawdown exceeds max_drawdown_pct."
+///
+/// Enforcement point: DispatcherChokepoint
+pub struct DrawdownGate {
+    max_drawdown_pct: f64,
+}
+
+impl DrawdownGate {
+    pub fn new(max_drawdown_pct: f64) -> Self {
+        Self { max_drawdown_pct }
+    }
+
+    pub fn check(&self, ctx: &TickContext) -> GateResult {
+        let drawdown = ctx.daily_drawdown_pct().unwrap_or(0.0);
+
+        if drawdown > self.max_drawdown_pct {
+            GateResult::Reject(RejectReasonCode::DrawdownExceeded)
+        } else {
+            GateResult::Pass
+        }
+    }
+
+    /// Resolve trading mode based on drawdown severity.
+    pub fn resolve_mode(&self, ctx: &TickContext) -> TradingMode {
+        let drawdown = ctx.daily_drawdown_pct().unwrap_or(0.0);
+        let cached = ctx.cached_trading_mode();
+
+        match cached {
+            Some(mode) => mode,
+            None => TradingMode::Active,  // if no cached mode, default to Active
+        }
+    }
+}
+
+/// Helper: get effective mode, falling back to Active for unknown states
+pub fn effective_mode(mode: Option<TradingMode>) -> TradingMode {
+    mode.unwrap_or(TradingMode::Active)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_drawdown_gate_allows_below_threshold() {
+        let gate = DrawdownGate::new(5.0);
+        let ctx = TickContext::with_drawdown(3.0);
+        let result = gate.check(&ctx);
+        assert!(matches!(result, GateResult::Pass));
+    }
+}
