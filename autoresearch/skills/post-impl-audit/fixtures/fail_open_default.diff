+//! AT-090: DrawdownGate acceptance tests
+
+use soldier_core::execution::{ExecutionEngine, ExecutionInput};
+use soldier_core::test_helpers::TestScenario;
+
+/// TRIP test: drawdown exceeds max -> OPEN order rejected
+#[test]
+fn test_at090_drawdown_gate_trip_open_rejected_when_drawdown_exceeds_max() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_daily_drawdown_pct(8.0)     // above 5% max
+        .with_max_drawdown_pct(5.0);
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 0, "OPEN must not dispatch when drawdown exceeds max");
+    assert_eq!(
+        result.reject_reason,
+        RejectReasonCode::DrawdownExceeded,
+        "reject reason must be DrawdownExceeded"
+    );
+}
+
+/// NON-TRIP test: drawdown below max -> OPEN order passes
+#[test]
+fn test_at090_drawdown_gate_non_trip_open_passes_when_drawdown_below_max() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_daily_drawdown_pct(3.0)     // below 5% max
+        .with_max_drawdown_pct(5.0);
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 1, "OPEN must dispatch when drawdown is below max");
+}
+
+/// TRIP test: missing drawdown data -> fail-closed reject
+#[test]
+fn test_at090_drawdown_gate_trip_missing_drawdown_fail_closed() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .without_drawdown_data();
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 0, "OPEN must not dispatch when drawdown data missing");
+}
