+use crate::execution::{GateResult, RejectReasonCode};
+use crate::types::{IntentClass, TickContext};
+
+/// Momentum Gate: blocks OPEN orders when short-term momentum
+/// is adverse (counter-trend protection).
+///
+/// Contract: SS2.3.12 — "OPEN orders MUST be rejected when
+/// momentum_score is below min_momentum_threshold."
+///
+/// Enforcement point: DispatcherChokepoint
+pub struct MomentumGate {
+    min_momentum_threshold: f64,
+}
+
+impl MomentumGate {
+    pub fn new(min_momentum_threshold: f64) -> Self {
+        Self { min_momentum_threshold }
+    }
+
+    pub fn check(&self, intent_class: &IntentClass, ctx: &TickContext) -> GateResult {
+        let momentum = match ctx.momentum_score() {
+            Some(m) if m.is_finite() => m,
+            _ => {
+                tracing::warn!("momentum data missing — fail-closed reject");
+                return GateResult::Reject(RejectReasonCode::MomentumDataMissing);
+            }
+        };
+
+        match intent_class {
+            IntentClass::Open if momentum < self.min_momentum_threshold => {
+                GateResult::Reject(RejectReasonCode::MomentumTooLow)
+            }
+            _ => GateResult::Pass,
+        }
+    }
+}
