diff --git a/crates/soldier_core/tests/test_momentum_gate.rs b/crates/soldier_core/tests/test_momentum_gate.rs
new file mode 100644
index 0000000..kkk7777
--- /dev/null
+++ b/crates/soldier_core/tests/test_momentum_gate.rs
@@ -0,0 +1,46 @@
+//! AT-100: MomentumGate acceptance tests
+
+use soldier_core::execution::{ExecutionEngine, ExecutionInput};
+use soldier_core::test_helpers::TestScenario;
+
+/// TRIP test: momentum below threshold -> OPEN order rejected
+#[test]
+fn test_at100_momentum_gate_trip_open_rejected_when_momentum_low() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_momentum_score(-0.5)
+        .with_min_momentum_threshold(0.0);
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 0, "OPEN must not dispatch when momentum below threshold");
+    assert_eq!(
+        result.reject_reason,
+        RejectReasonCode::MomentumTooLow,
+        "reject reason must be MomentumTooLow"
+    );
+}
+
+/// NON-TRIP test: momentum above threshold -> OPEN order passes
+#[test]
+fn test_at100_momentum_gate_non_trip_open_passes_when_momentum_above_threshold() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_momentum_score(0.5)
+        .with_min_momentum_threshold(0.0);
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 1, "OPEN must dispatch when momentum is above threshold");
+}
+
+/// TRIP test: missing momentum data -> fail-closed reject
+#[test]
+fn test_at100_momentum_gate_trip_missing_data_fail_closed() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .without_momentum_data();
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 0, "OPEN must not dispatch when momentum data missing");
+}
