+use crate::execution::{GateResult, RejectReasonCode};
+use crate::types::{IntentClass, TickContext};
+
+/// Latency Gate: blocks OPEN orders when venue round-trip latency
+/// exceeds the configured threshold.
+///
+/// Contract: SS2.3.9 — "OPEN orders MUST be rejected when venue
+/// latency exceeds latency_ceiling_ms."
+///
+/// Enforcement point: DispatcherChokepoint
+pub struct LatencyGate {
+    latency_ceiling_ms: u64,
+}
+
+impl LatencyGate {
+    pub fn new(latency_ceiling_ms: u64) -> Self {
+        Self { latency_ceiling_ms }
+    }
+
+    pub fn check(&self, intent_class: &IntentClass, ctx: &TickContext) -> GateResult {
+        let latency = match ctx.venue_latency_ms() {
+            Some(l) => l,
+            None => {
+                tracing::warn!("venue latency unavailable — fail-closed reject");
+                return GateResult::Reject(RejectReasonCode::LatencyDataMissing);
+            }
+        };
+
+        match intent_class {
+            IntentClass::Open if latency > self.latency_ceiling_ms => {
+                tracing::info!(latency_ms = latency, ceiling = self.latency_ceiling_ms, "latency gate TRIP");
+                GateResult::Reject(RejectReasonCode::LatencyTooHigh)
+            }
+            _ => GateResult::Pass,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_latency_gate_basic() {
+        let gate = LatencyGate::new(100);
+        assert_eq!(gate.latency_ceiling_ms, 100);
+    }
+}
