@@ -0,0 +1,25 @@
+//! AT-070: LatencyGate acceptance tests
+
+use soldier_core::execution::{ExecutionEngine, ExecutionInput};
+use soldier_core::test_helpers::TestScenario;
+
+/// NON-TRIP test: latency below ceiling -> OPEN order passes
+/// Proves: dispatch_count == 1
+#[test]
+fn test_at070_latency_gate_non_trip_open_passes_when_latency_low() {
+    let mut scenario = TestScenario::new()
+        .with_risk_state_healthy()
+        .with_all_gates_pass()
+        .with_venue_latency_ms(50)     // below 100ms ceiling
+        .with_latency_ceiling_ms(100);
+
+    let result = scenario.dispatch_open_intent();
+
+    assert_eq!(result.dispatch_count, 1, "OPEN must dispatch when latency is below ceiling");
+}
+
