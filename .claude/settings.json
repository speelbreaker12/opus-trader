{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-commit-review-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/rust-skills-prompt-hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/scripts/dangerous-command-blocker.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/scripts/secret-scanner.py"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pr-review-gate-hook.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-verify-fmt.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/vault-update-check.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/rust-skills-edit-hook.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/rust-skills-edit-hook.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  }
}
