#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: run safety checks before committing
# Skip with: git commit --no-verify

# Ensure we're at repo root (hooks run from caller's working directory)
cd "$(git rev-parse --show-toplevel)"

echo "Running pre-commit checks..."

# 0. Main branch guard — no real work on main
current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
  echo ""
  echo "ERROR: Commits on main are blocked."
  echo "Main is for syncing and cutting new worktrees only."
  echo "Create a worktree: git worktree add <path> -b <branch>"
  echo ""
  exit 1
fi

# 1. Block new planning artifacts in banned repo paths
# Block new files in banned planning paths (exempt premortems/reconciliations — active workflow)
NEW_BANNED=$(git diff --cached --name-only --diff-filter=A | grep -E "^(obsidian/|docs/superpowers/specs/|docs/superpowers/plans/)" || true)
NEW_REVIEWS=$(git diff --cached --name-only --diff-filter=A | grep -E "^reviews/" | grep -vE "^reviews/(premortems|reconciliations)/" || true)
NEW_PLANNING="${NEW_BANNED}${NEW_REVIEWS:+$'\n'}${NEW_REVIEWS}"
NEW_PLANNING=$(echo "$NEW_PLANNING" | sed '/^$/d')
if [[ -n "$NEW_PLANNING" ]]; then
  echo ""
  echo "ERROR: New planning artifacts must go in the external Obsidian vault, not the repo."
  echo "Blocked files:"
  echo "$NEW_PLANNING"
  echo ""
  echo "Write to ~/Desktop/obsidian/ instead. See AGENTS.md 'Workflow Policy'."
  exit 1
fi

# 2. Project scope guard (all commits)
plans/project_scope_guard.sh commit

# 3. SSOT lint (existing)
plans/ssot_lint.sh

# 4. Contract cross-reference check (if CONTRACT.md is staged)
if git diff --cached --name-only | grep -q "specs/CONTRACT.md"; then
  echo "CONTRACT.md staged - running cross-reference check..."
  if ! python3 scripts/check_contract_crossrefs.py --contract specs/CONTRACT.md --strict --check-at; then
    echo ""
    echo "ERROR: Contract cross-reference check failed"
    echo "Fix the issues above before committing"
    exit 1
  fi
fi

# 5. PRD schema check (if prd.json is staged)
if git diff --cached --name-only | grep -q "plans/prd.json"; then
  echo "prd.json staged - running schema check..."
  if ! plans/prd_schema_check.sh plans/prd.json; then
    echo ""
    echo "ERROR: PRD schema validation failed"
    echo "Run 'plans/prd_gate.sh' for full diagnostics"
    exit 1
  fi
fi

# 6. Check for unwrap() in staged Rust files (safety-critical paths only)
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^crates/soldier_core/.*\.rs$" || true)
if [[ -n "$STAGED_RS" ]]; then
  echo "Checking staged soldier_core files for unwrap()..."
  UNWRAP_FOUND=0
  for file in $STAGED_RS; do
    # Skip test files
    if [[ "$file" == *"test"* ]]; then
      continue
    fi
    if git diff --cached "$file" | grep -q "\.unwrap()"; then
      echo "WARN: unwrap() added in $file"
      UNWRAP_FOUND=1
    fi
  done
  if [[ $UNWRAP_FOUND -eq 1 ]]; then
    echo ""
    echo "WARNING: unwrap() found in staged changes"
    echo "Consider using ? or .ok_or() instead"
    echo "(Proceeding anyway - this is a warning only)"
    echo ""
  fi
fi

# 7. Enforce code-review-expert attestation for significant implementation changes
plans/code_review_expert_guard.sh

echo "Pre-commit checks passed."
