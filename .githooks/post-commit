#!/bin/sh

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

QUEUE_COUNT=$(python3 - <<'PY'
import json
import os

home = os.path.expanduser(os.environ.get("CODEX_HOME", os.path.join("~", ".codex")))
queue_path = os.path.join(home, "learnings-queue.json")

try:
    with open(queue_path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
    if isinstance(data, list):
        print(len(data))
    else:
        print(0)
except Exception:
    print(0)
PY
)

if [ "$QUEUE_COUNT" -gt 0 ] 2>/dev/null; then
  printf 'stoic-reflect: queue has %s items \xE2\x86\x92 run $stoic-reflect\n' "$QUEUE_COUNT"
fi

if git rev-parse --verify --quiet HEAD~1 >/dev/null 2>&1; then
  if git diff --name-only --find-renames --find-copies HEAD~1 HEAD -- "obsidian/Active Projects.md" | grep -q "^obsidian/Active Projects.md$"; then
    printf 'obsidian: Active Projects dashboard auto-sync touched this commit.\n'
  fi
fi
