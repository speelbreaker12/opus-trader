{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": ["convex/**/*.ts"]
}
