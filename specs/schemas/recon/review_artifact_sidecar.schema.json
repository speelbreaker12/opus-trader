{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_artifact_sidecar.v1",
  "type": "object",
  "required": [
    "schema_version",
    "head_commit",
    "created_at",
    "markdown_sha256",
    "markdown_path",
    "story_id",
    "review_type",
    "review_basis",
    "tool",
    "phase_equivalent",
    "citations_count",
    "pre_existing_citations_count",
    "finding_counts",
    "basis_line_present"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[a-z_]+\\.v[0-9]+$"
    },
    "head_commit": { "type": "string", "minLength": 7 },
    "created_at": { "type": "string", "format": "date-time" },
    "markdown_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "markdown_path": { "type": "string", "minLength": 1 },
    "story_id": { "type": "string", "minLength": 1 },
    "review_type": {
      "type": "string",
      "enum": [
        "external",
        "contract_review",
        "strategic_review",
        "wiring_audit",
        "code_review",
        "devils_advocate",
        "debt_validation"
      ]
    },
    "review_basis": {
      "type": "string",
      "enum": ["STORY_SCOPE", "FIX_DIFF_AT_REGRESSION", "FIX_DIFF + AT_REGRESSION (Cycle 2)"],
      "$comment": "JSON-short forms preferred; human-readable alias accepted for compatibility with review_logged.sh markdown output"
    },
    "tool": { "type": ["string", "null"] },
    "model": { "type": "string", "minLength": 1 },
    "prompt_style": {
      "type": "string",
      "enum": ["generic", "enriched"]
    },
    "cycle": {
      "type": "string",
      "enum": ["C1", "C2"]
    },
    "phase_equivalent": { "type": "string", "minLength": 1 },
    "citations_count": { "type": "integer", "minimum": 0 },
    "pre_existing_citations_count": { "type": "integer", "minimum": 0 },
    "finding_counts": {
      "type": "object",
      "required": ["P0", "P1", "P2", "INFO"],
      "additionalProperties": false,
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 },
        "INFO": { "type": "integer", "minimum": 0 }
      }
    },
    "basis_line_present": { "type": "boolean" }
  }
}
