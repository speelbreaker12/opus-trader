{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verify_result.v1",
  "type": "object",
  "required": [
    "schema_version",
    "head_commit",
    "created_at",
    "story_id",
    "verdict",
    "p0_closed",
    "p1_closed_or_deferred",
    "weak_proof_escalated",
    "tests_pass",
    "stoplight_delta",
    "r5b_receipts_verified",
    "evidence_ledger_updated"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[a-z_]+\\.v[0-9]+$"
    },
    "head_commit": { "type": "string", "minLength": 7 },
    "created_at": { "type": "string", "format": "date-time" },
    "story_id": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": ["RECONCILED", "RECONCILED_WITH_DEBT", "NOT_RECONCILED"]
    },
    "p0_closed": { "type": "boolean" },
    "p1_closed_or_deferred": { "type": "boolean" },
    "weak_proof_escalated": { "type": "boolean" },
    "tests_pass": { "type": "boolean" },
    "stoplight_delta": {
      "type": "string",
      "enum": ["UNCHANGED", "DOWNGRADED_YELLOW", "DOWNGRADED_RED"]
    },
    "r5b_receipts_verified": { "type": "boolean" },
    "evidence_ledger_updated": { "type": "boolean" }
  }
}
