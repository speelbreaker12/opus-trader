{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead_eval_sidecar.v1",
  "type": "object",
  "required": [
    "schema_version",
    "head_commit",
    "created_at",
    "markdown_sha256",
    "markdown_path",
    "story_ids",
    "citation_checks_performed",
    "verdict_overrides",
    "red_flags",
    "overall_ratings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[a-z_]+\\.v[0-9]+$"
    },
    "head_commit": { "type": "string", "minLength": 7 },
    "created_at": { "type": "string", "format": "date-time" },
    "markdown_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "markdown_path": { "type": "string", "minLength": 1 },
    "story_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "citation_checks_performed": { "type": "integer", "minimum": 0 },
    "verdict_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "story_id",
          "at_id",
          "from_verdict",
          "to_verdict",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "story_id": { "type": "string", "minLength": 1 },
          "at_id": { "type": "string", "pattern": "^AT-" },
          "from_verdict": { "type": "string", "minLength": 1 },
          "to_verdict": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["story_id", "description", "severity"],
        "additionalProperties": false,
        "properties": {
          "story_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM"]
          }
        }
      }
    },
    "overall_ratings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["PASS", "PASS_WITH_ISSUES", "NEEDS_PATCH", "REJECT"]
      }
    }
  }
}
