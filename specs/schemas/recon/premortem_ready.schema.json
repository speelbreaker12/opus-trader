{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "premortem_ready.v1",
  "type": "object",
  "required": [
    "schema_version",
    "head_commit",
    "created_at",
    "story_id",
    "ready",
    "premortem_exists",
    "stoplight",
    "stoplight_is_red",
    "ownership_conflicts",
    "ownership_conflict_details",
    "sections_present",
    "premortem_gate_exit_code",
    "reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[a-z_]+\\.v[0-9]+$"
    },
    "head_commit": { "type": "string", "minLength": 7 },
    "created_at": { "type": "string", "format": "date-time" },
    "story_id": { "type": "string", "minLength": 1 },
    "ready": { "type": "boolean" },
    "premortem_exists": { "type": "boolean" },
    "stoplight": {
      "type": "string",
      "enum": ["GREEN", "YELLOW", "RED"]
    },
    "stoplight_is_red": { "type": "boolean" },
    "ownership_conflicts": { "type": "integer", "minimum": 0 },
    "ownership_conflict_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at_id", "claiming_stories"],
        "additionalProperties": false,
        "properties": {
          "at_id": { "type": "string", "pattern": "^AT-" },
          "claiming_stories": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          }
        }
      }
    },
    "sections_present": {
      "type": "object",
      "required": [
        "s0", "s1", "s2", "s3", "s4",
        "s5", "s6", "s7", "s8", "s9", "s10"
      ],
      "additionalProperties": false,
      "properties": {
        "s0": { "type": "boolean" },
        "s1": { "type": "boolean" },
        "s2": { "type": "boolean" },
        "s3": { "type": "boolean" },
        "s4": { "type": "boolean" },
        "s5": { "type": "boolean" },
        "s6": { "type": "boolean" },
        "s7": { "type": "boolean" },
        "s8": { "type": "boolean" },
        "s9": { "type": "boolean" },
        "s10": { "type": "boolean" }
      }
    },
    "premortem_gate_exit_code": { "type": "integer", "minimum": 0 },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
