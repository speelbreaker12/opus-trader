{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_receipt.v1",
  "type": "object",
  "required": [
    "schema_version",
    "head_commit",
    "created_at",
    "story_id",
    "review_basis",
    "review_basis_cycle",
    "tool",
    "prompt_style",
    "phase_equivalent",
    "citations",
    "findings",
    "finding_counts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[a-z_]+\\.v[0-9]+$"
    },
    "head_commit": { "type": "string", "minLength": 7 },
    "created_at": { "type": "string", "format": "date-time" },
    "story_id": { "type": "string", "minLength": 1 },
    "review_basis": {
      "type": "string",
      "enum": ["STORY_SCOPE", "FIX_DIFF_AT_REGRESSION", "FIX_DIFF + AT_REGRESSION (Cycle 2)"],
      "$comment": "JSON-short forms preferred; human-readable alias accepted for compatibility with review_logged.sh markdown output"
    },
    "review_basis_cycle": {
      "type": "integer",
      "enum": [1, 2]
    },
    "tool": { "type": "string", "minLength": 1 },
    "prompt_style": {
      "type": "string",
      "enum": ["generic", "enriched"]
    },
    "phase_equivalent": {
      "type": "string",
      "enum": ["R1", "R3", "R7"]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_line", "tag", "in_diff"],
        "additionalProperties": false,
        "properties": {
          "file_line": { "type": "string", "minLength": 1 },
          "tag": {
            "type": "string",
            "enum": ["enforcement", "test", "other"]
          },
          "in_diff": { "type": "boolean" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "classification", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "INFO"]
          },
          "classification": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "finding_counts": {
      "type": "object",
      "required": ["P0", "P1", "P2", "INFO"],
      "additionalProperties": false,
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 },
        "INFO": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
