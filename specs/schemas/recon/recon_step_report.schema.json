{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recon_step_report.v1",
  "type": "object",
  "required": [
    "schema_version",
    "head_commit",
    "created_at",
    "story_id",
    "step_name",
    "step_index",
    "status",
    "exit_code",
    "commands_run",
    "files_changed",
    "strongest_evidence",
    "not_done"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "recon_step_report.v1"
    },
    "head_commit": {
      "type": "string",
      "minLength": 7
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "step_name": {
      "type": "string",
      "enum": [
        "preflight",
        "implement",
        "self_review",
        "cycle1",
        "fix",
        "cycle2",
        "resolution",
        "verify_full",
        "pass"
      ]
    },
    "step_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "commands_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strongest_evidence": {
      "type": "string",
      "minLength": 1
    },
    "not_done": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
